# HubSpot form target for the Enterprise "Talk to sales" form.
#
# These are PUBLIC identifiers, not secrets. HubSpot's forms submission endpoint is
# unauthenticated by design, and both values are visible in the browser on any page
# that embeds the form — so committing them changes nothing about their exposure and
# keeps the Vercel build working without extra configuration.
#
# Never put a real secret (private app token, API key) in this file. Use .env.local,
# which is gitignored, or Vercel's environment variables.

PORTAL_ID=245270532
FORM_ID=880db7f0-a9b2-4062-9f2f-f3e79c720426
